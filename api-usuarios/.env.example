# PostgreSQL local. Para hospedagem, deixe DATABASE_URL configurada no provedor.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_usuarios
DB_USER=postgres
DB_PASSWORD=COLOQUE_SUA_SENHA_LOCAL_AQUI

# Gere um segredo aleatorio para desenvolvimento local.
JWT_SECRET=GERE_UM_SEGREDO_ALEATORIO
NODE_ENV=development
PORT=3000

# Opcional: se definida, substitui DB_HOST, DB_PORT, DB_NAME, DB_USER e DB_PASSWORD.
# DATABASE_URL=COLE_SUA_URL_POSTGRESQL_AQUI
